                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"inputs\": [\n    {\n      \"name\": \"prompt\",\n      \"shape\": [\n        1\n      ],\n      \"datatype\": \"BYTES\",\n      \"data\": [\n        \"What is AI?\"\n      ]\n    }\n  ]\n}",
                  "options": {
