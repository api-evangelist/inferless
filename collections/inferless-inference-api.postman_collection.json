      "item": [
        {
          "id": "27fb8d58-df71-439d-b22e-d974c589493a",
          "name": "Run inference against a deployed model.",
          "request": {
            "name": "Run inference against a deployed model.",
            "description": {
              "content": "Sends an inference request to a deployed model's auto-generated endpoint. The request body uses the KServe v2 inputs[] structure (name, shape, datatype, data). This path is served from the per-deployment inference host, not from api.inferless.com.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v2",
                "inference",
                ":model_name",
                "infer"
              ],
              "host": [
                "{{modelId}}",
                "{{region}}",
                "model-v1",
                "inferless",
                "com"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "model_name",
                  "description": "(Required) The model name segment of the auto-generated inference URL."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inputs\": [\n    {\n      \"name\": \"<string>\",\n      \"shape\": [\n        \"<integer>\",\n        \"<integer>\"\n      ],\n      \"datatype\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"shape\": [\n        \"<integer>\",\n        \"<integer>\"\n      ],\n      \"datatype\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "cadc8854-6d04-4a7b-91a4-42770b57cb5e",
              "name": "Inference result.",
              "originalRequest": {
