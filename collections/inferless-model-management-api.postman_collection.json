          "name": "Update a model's autoscaling and machine settings.",
          "request": {
            "name": "Update a model's autoscaling and machine settings.",
            "description": {
              "content": "Updates a deployed model's configuration including min/max replicas, scale-down delay, inference timeout, dedicated vs shared, machine type, and container concurrency.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "model",
                "settings",
                "update",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model_id\": \"<string>\",\n  \"data\": {\n    \"min_replica\": \"<integer>\",\n    \"max_replica\": \"<integer>\",\n    \"scale_down_delay\": \"<integer>\",\n    \"inference_time\": \"<integer>\",\n    \"is_dedicated\": \"<boolean>\",\n    \"machine_type\": \"<string>\",\n    \"container_concurrency\": \"<integer>\",\n    \"is_input_output_enabled\": \"<boolean>\"\n  }\n}",
