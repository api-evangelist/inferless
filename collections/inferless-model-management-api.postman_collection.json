        {
          "id": "d3a6daa7-c5d8-497a-9931-1ca751dd6308",
          "name": "Retrieve runtime logs for a deployed model.",
          "request": {
            "name": "Retrieve runtime logs for a deployed model.",
            "description": {
              "content": "Returns stdout/stderr log entries for a deployed model over a time range, with optional pagination via next_token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "model",
                "logs",
                "get",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model_id\": \"<string>\",\n  \"time_from\": \"<string>\",\n  \"time_to\": \"<string>\",\n  \"is_less_logs\": \"<boolean>\",\n  \"next_token\": \"<string>\"\n}",
